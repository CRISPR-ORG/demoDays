# ─────────────────────────────────────────────────────────────
#  IIITN Demo Days — server configuration
#  Copy to `server/.env` and fill in. See README.md → "Google setup".
# ─────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Comma-separated origins allowed to call the API in development.
CORS_ORIGIN=http://localhost:5173

# ── Destinations (already pointing at your sheet + folder) ───
GOOGLE_SHEET_ID=1EJvP3factXilqJ-lzGl8VmQcXlzea0Jl2TwPFOfjT3Q
GOOGLE_SHEET_TAB=Registrations
GOOGLE_DRIVE_FOLDER_ID=1nRiv-38lDkpM2fgLQk5zsjbFjhiuh1m3

# ── Auth: pick ONE of the two modes below ────────────────────

# MODE A — Service account (simplest; required for a Shared Drive)
# Path to the downloaded JSON key, or paste the whole JSON on one line.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# MODE B — OAuth user credentials (needed to upload into a personal My Drive
# folder, because service accounts have no Drive storage quota of their own)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# Set true if the Drive folder lives in a Shared Drive (Team Drive).
GOOGLE_DRIVE_IS_SHARED_DRIVE=false

# Registration window (ISO 8601). Submissions are refused after it closes.
REGISTRATION_CLOSES_AT=2026-09-15T20:00:00+05:30
# Set true to keep accepting entries even after the deadline passes.
ALLOW_LATE_REGISTRATION=false
